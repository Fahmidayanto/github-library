# ==============================================================================
# GitHub Library Hub - Frontend Environment Variables Template
# ==============================================================================

# 1. Localhost Backend Endpoint (Express API server port 4000)
# Ubah ke URL backend production jika dideploy terpisah di cloud
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"

# 2. Path / Base URL Frontend (Next.js port 3055 lokal, atau domain Vercel di prod)
NEXT_PUBLIC_APP_URL="http://localhost:3055"

# Database PostgreSQL Neon
DATABASE_URL="postgresql://user:password@endpoint-pooler.tech/neondb?sslmode=require"

# AI Inference Keys (Google Gemini & Groq)
GEMINI_API_KEY=""
GROQ_API_KEY=""

